<div class="SD-box grid-colspan-2">
	<div class="header">
		<label for="secret">
			{{localize "SHADOWDARK.apps.character-generator.secret"}}
		</label>
		<span>
			{{#unless editing}}
				<a
					class="fas fa-dice"
					data-action='cg-click'
					name="randomize-secret"
				></a>
			{{/unless}}
		</span>
	</div>

	<div class="content">
		<div id="secret" class="secret-text">{{secret}}</div>
	</div>
</div>
