<div class="SD-box">
	<div class="header">
		<label
			for="actor.system.background"
			title="{{localize 'SHADOWDARK.sheet.player.background.tooltip'}}"
		>
			{{localize 'SHADOWDARK.sheet.player.background.label'}}
		</label>
		<span>
			{{#unless editing}}
				<a
					class="fas fa-dice"
					data-action='cg-click'
					name="randomize-background"
				></a>
			{{/unless}}
		</span>
	</div>

	<div class="content">
		<select
			id="background"
			name="actor.system.background"
			{{disabled editing}}
		>
			<option value=""></option>
			{{#each backgroundGroups as |group|}}
				{{#if group.name}}
					<optgroup label="{{group.name}}">
						{{#each group.backgrounds as |value|}}
							<option
								title="{{value.description}}"
								value="{{value.uuid}}"
								{{#if value.selected}}selected{{/if}}
							>
								{{value.name}}
							</option>
						{{/each}}
					</optgroup>
				{{else}}
					{{#each group.backgrounds as |value|}}
						<option
							title="{{value.description}}"
							value="{{value.uuid}}"
							{{#if value.selected}}selected{{/if}}
						>
							{{value.name}}
						</option>
					{{/each}}
				{{/if}}
			{{/each}}
		</select>
	</div>
</div>
