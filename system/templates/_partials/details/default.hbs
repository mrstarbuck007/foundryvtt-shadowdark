{{#if spells}}
	{{#if isSpellsTab}}
		{{#each spells}}
			<div class="details-description">
				{{{this.spellDescription}}}
			</div>
			<span class="item-subtext">
				{{{spanBullets this.subtext}}}
			</span>
		{{/each}}
	{{else}}
		{{{description}}}
		{{#if isIdentified}}
			{{#each spells}}
				<span class="item-subtext">
					<b>
						{{this.name}}
					</b>
					{{{spanBullets this.subtext}}}
				</span>
			{{/each}}
		{{/if}}
	{{/if}}
{{else}}
	{{{description}}}
	{{#if item.system.subtext}}
		<span class="item-subtext">
			{{{spanBullets item.system.subtext}}}
		</span>
	{{/if}}
{{/if}}
