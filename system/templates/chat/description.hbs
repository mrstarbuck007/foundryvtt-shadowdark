<div class="item-wrapper">
	<div class="item-header">
		<a data-link data-uuid="{{item.uuid}}">
			<img class="item-image" src="{{item.img}}">
		</a>
		<div class="item-text-wrapper" {{#if description}}data-action="expandDescription"{{/if}}>
			<span class="item-name">
				{{item.name}}

			</span>
			<span class="item-subtext">
				{{subtext item.system.subtext attackType}}
				{{#if ammunitionName}}<span> • </span>{{ammunitionName}}{{/if}}
			</span>
		</div>
		{{#if description}}<i class="fa-thin fa-caret-right"></i>{{/if}}
	</div>

	<div class="description">
		<div class="description-wrapper">
			{{{description}}}
		</div>
	</div>
</div>
